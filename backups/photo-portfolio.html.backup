<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>photo portfolio</title>
    <link rel="stylesheet" href="css/reset.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700&display=swap">
    <link rel="stylesheet" href="css/style.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>


    <script defer type='module' src="js/app.js"></script>
    <script defer type ='module' src="js/photo.js"></script>




    <!--set favicon-->
    <link rel="shortcut icon" type="image/png" href="images/dog.png">
</head>
<body class="alt-page">
        <div class="wave"></div>

    <div class="content">
        <div class="background-container">
                <div id="navbar"></div>
                <img src="images/star.svg" class="scroll-widget">

                <div id="photo-gallery-container">
                        <h2 class="page-heading">my photography</h2>
                </div>

                <div class="page-description">
                    <p>photos taken from across the years! </p>
                </div>

                <img src="images/shrkshkk.png" alt="Logo" class="logo">

                <div class="tag-buttons">
                    <button data-tag="2019">2019</button>
                    <button data-tag="2022">2022</button>
                    <button data-tag="2023">2023</button>
                    <button data-tag="2024">2024</button>
                    <button data-tag="2025">2025</button>
                    <button data-tag="all">all</button>
                </div>

                <div class="art-gallery"></div>

            </div>
    </div>
    
</body>
</html>
